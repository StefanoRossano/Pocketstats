<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4D8DFF</item>
        <item name="android:navigationBarColor">#070B12</item>
        <item name="android:statusBarColor">#070B12</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Senza questo, i dialog usavano il tema di sistema di default (spesso grigio chiaro),
             stonando con la palette scura del resto dell'app. Applicandolo qui, sul tema
             dell'Activity, si propaga automaticamente a OGNI AlertDialog senza dover modificare
             ciascun punto del codice in cui viene creato. -->
        <item name="android:alertDialogTheme">@style/PocketDialogTheme</item>
    </style>

    <style name="PocketDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A5AFBE</item>
        <item name="android:colorAccent">#3778FF</item>
    </style>
</resources>
