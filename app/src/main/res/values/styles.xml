<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principale dell'app: l'intera interfaccia e' disegnata a mano su Canvas (TrackerView), quindi
         non serve nessuna action bar ne' altro chrome di sistema — solo uno sfondo scuro coerente con
         quello disegnato dall'app stessa, cosi' non c'e' un lampo bianco/chiaro nell'istante prima che il
         primo frame venga disegnato. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Applica PocketAlertDialogTheme a OGNI "new AlertDialog.Builder(this)" dell'app automaticamente,
             senza dover toccare ciascuna chiamata nel codice: prima questi dialog (correzione manuale,
             rinomina Stagione, nuovo deck, ecc.) apparivano nel tema Material generico, diverso dagli altri
             dialog dell'app (che impostano i colori a mano su un Dialog+LinearLayout custom). -->
        <item name="android:alertDialogTheme">@style/PocketAlertDialogTheme</item>
    </style>

    <!-- Tema per i Dialog custom dell'app (menu, form, wizard, popup a schermo intero): parte da
         Theme.Material.Dialog.Alert ma senza titolo/chrome — ogni dialog imposta il proprio sfondo e
         layout via codice (setContentView + setBackgroundDrawable), qui serve solo la base giusta perche'
         quelle chiamate funzionino senza padding/inset indesiderati imposti dal tema di sistema. -->
    <style name="PocketDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Tema per gli AlertDialog.Builder standard (quelli che NON costruiscono un Dialog custom a mano):
         stesso sfondo navy arrotondato e stesso blu di accento (usato per i pulsanti "Conferma") degli
         altri dialog dell'app. Il testo dei pulsanti in MAIUSCOLO e' quello di default di Material — l'unica
         cosa che si voleva tenere di quel tema, quindi non viene toccato. -->
    <style name="PocketAlertDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/pocket_alert_dialog_bg</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:colorAccent">#3778FF</item>
    </style>
</resources>
